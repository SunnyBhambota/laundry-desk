rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Owner profile and shop: only the owner.
    match /owners/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /shops/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /shopData/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Shop code → owner id (staff login lookup). Readable by signed-in users only.
    match /shopCodes/{code} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
    }
  }
}
